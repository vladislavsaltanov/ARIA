<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             xmlns:model="using:Aria.Core.Model"
             x:Class="Aria.App.Views.ScriptPanel"
             x:DataType="vm:ScriptPanelViewModel">
  <UserControl.Styles>
    <Style Selector="Border.scriptLine">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.scriptLine:pointerover">
      <Setter Property="Background" Value="{StaticResource BrushHover}"/>
    </Style>
    <Style Selector="Border.scriptLine.current">
      <Setter Property="Background" Value="{StaticResource BrushSignalSoft}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushSignal}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>
    <Style Selector="Border.scriptLine.editing">
      <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushDim}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.scriptTime">
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="Border.scriptLine.current Button.scriptTime">
      <Setter Property="Foreground" Value="{StaticResource BrushSignal}"/>
    </Style>
    <Style Selector="Button.goHint">
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.scriptLine:pointerover Button.goHint">
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
    <Style Selector="Border.scriptLine.current Button.goHint">
      <Setter Property="Foreground" Value="{StaticResource BrushSignal}"/>
    </Style>
    <Style Selector="Border.mention">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="Border.mention:pointerover">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushFg}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.mention.dangling">
      <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
    </Style>
    <Style Selector="Border.mention.dangling TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="Button.scriptFooter">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.scriptFooter /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.scriptFooter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
    <Style Selector="Button.scriptFooter:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="ListBox#TabsList ListBoxItem">
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style Selector="ListBox#TabsList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="11,3"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox#TabsList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="ListBox#TabsList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
    <Style Selector="ListBox#TabsList ListBoxItem TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="ListBox#TabsList ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Tapped="OnPanelTapped">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox x:Name="ScriptNameBox" Text="{Binding SelectedScript.Name, Mode=OneWay}"
               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" VerticalContentAlignment="Center"
               Background="Transparent" BorderThickness="0" Padding="0"
               KeyDown="OnNameKeyDown" LostFocus="OnNameCommit"/>
      <Button Grid.Column="1" x:Name="PaneCloseButton" Classes="scriptFooter" Width="28" Height="28" Padding="0"
              Click="OnCloseClick" ToolTip.Tip="Скрыть панель — Ctrl+T">
        <PathIcon Data="{StaticResource icon_x}" Width="13" Height="13"/>
      </Button>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding HasScripts}">
      <ListBox x:Name="TabsList" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript, Mode=OneWay}"
               SelectionChanged="OnTabSelection" Background="Transparent" BorderThickness="0" Padding="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScriptPanelViewModel+ScriptVm">
            <TextBlock Text="{Binding Name}" FontSize="12"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Column="1" Classes="scriptFooter" Width="26" Height="26" Padding="0" Command="{Binding CreateScriptCommand}"
              ToolTip.Tip="Новый сценарий">
        <PathIcon Data="{StaticResource icon_plus}" Width="13" Height="13"/>
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="2" x:Name="LinesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <ItemsControl x:Name="LinesControl" ItemsSource="{Binding Lines}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ScriptPanelViewModel+ScriptLineVm">
              <Border Classes="scriptLine" Classes.current="{Binding IsCurrent}" Classes.editing="{Binding IsEditing}"
                      MinHeight="34" CornerRadius="6" Padding="8,6" Tapped="OnLineTapped">
                <Grid>
                  <Grid ColumnDefinitions="78,*,24" IsVisible="{Binding !IsEditing}">
                    <Grid Grid.Column="0">
                      <Button Tag="ScriptTime" Classes="ghost scriptTime" FontFamily="{StaticResource MonoFont}" FontSize="12"
                              Content="{Binding DisplayTime}"
                              ToolTip.Tip="{Binding WallTimeTip}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" Click="OnExecuteClick"/>
                      <Button Tag="ScriptGo" Classes="ghost goHint" Width="24" Height="24"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnExecuteClick"
                              ToolTip.Tip="Исполнить строку">
                        <PathIcon Data="{StaticResource icon_play}" Width="12" Height="12"/>
                      </Button>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Tag="ScriptText" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                                 IsVisible="{Binding HasText}"/>
                      <TextBlock Tag="ScriptText" Text="пустая строка…" FontSize="13" FontStyle="Italic"
                                 Foreground="{StaticResource BrushDim}" IsVisible="{Binding !HasText}"/>
                      <ItemsControl ItemsSource="{Binding Mentions}" Margin="0,5,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ScriptPanelViewModel+MentionVm">
                            <Button Tag="ScriptChip" Classes="ghost" Margin="0,0,6,4" Click="OnChipClick"
                                    PointerEntered="OnChipEnter" PointerExited="OnChipLeave"
                                    ToolTip.Tip="{Binding Tooltip}">
                              <Border Classes="mention" Classes.dangling="{Binding IsDangling}">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,5,0,0"
                                    IsVisible="{Binding CandidatesVisible}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ScriptPanelViewModel+MentionVm">
                            <Button Tag="ScriptCandidate" Classes="ghost" Margin="0,0,6,0" Click="OnCandidateClick"
                                    ToolTip.Tip="{Binding Tooltip}">
                              <Border Classes="mention">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="2" Tag="ScriptDelete" Classes="ghost" Width="24" Height="24"
                            VerticalAlignment="Top" Click="OnDeleteClick" ToolTip.Tip="Удалить строку">
                      <PathIcon Data="{StaticResource icon_x}" Width="11" Height="11"/>
                    </Button>
                  </Grid>
                  <Grid RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsEditing}">
                    <Grid Grid.Row="0" ColumnDefinitions="64,Auto" Margin="0,0,0,6">
                      <TextBox Text="{Binding EditTimeText, Mode=TwoWay}" FontFamily="{StaticResource MonoFont}"
                               FontSize="12" Padding="6,4" KeyDown="OnEditKeyDown"/>
                      <Button Grid.Column="1" Tag="ScriptMark" Classes="scriptFooter" MinHeight="26" Padding="10,0"
                              FontSize="11" Content="сейчас" Margin="8,0,0,0" Click="OnMarkNowClick"
                              ToolTip.Tip="Пометить текущее время шоу"/>
                    </Grid>
                    <TextBox Grid.Row="1" Text="{Binding EditText, Mode=TwoWay}" FontSize="13" TextWrapping="Wrap"
                             Padding="6,4" KeyDown="OnEditKeyDown" TextChanged="OnEditTextChanged"/>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding StagedMentions}" Margin="0,6,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScriptPanelViewModel+MentionVm">
                          <Button Tag="ScriptStaged" Classes="ghost" Margin="0,0,6,4" Click="OnStagedClick"
                                  ToolTip.Tip="Убрать упоминание">
                            <Border Classes="mention" Classes.dangling="{Binding IsDangling}">
                              <TextBlock Text="{Binding DisplayName}" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Popup Grid.Row="1" IsOpen="{Binding SuggestionsVisible, Mode=TwoWay}"
                           IsLightDismissEnabled="True" Placement="Bottom" ShouldUseOverlayLayer="True">
                      <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}"
                              BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="200">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:Track">
                              <Button Tag="ScriptSuggest" Classes="ghost" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left" Padding="8,6" Click="OnSuggestClick">
                                <TextBlock Text="{Binding DefaultName}" FontSize="12"/>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Popup>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Canvas x:Name="DropIndicator" IsVisible="False" IsHitTestVisible="False">
          <Border x:Name="DropLine" Height="2" Background="{StaticResource BrushFg}" CornerRadius="1" Width="100"/>
        </Canvas>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <StackPanel IsVisible="{Binding ShowNoScripts}" Spacing="8" Margin="0,24,0,0" HorizontalAlignment="Center">
        <PathIcon Data="{StaticResource icon_script}" Width="24" Height="24" Foreground="{StaticResource BrushFaint}"
                  HorizontalAlignment="Center"/>
        <TextBlock Text="Сценариев нет" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="scriptFooter"
                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                  Command="{Binding CreateScriptCommand}" Content="+ Новый сценарий"/>
          <Button x:Name="ImportScriptButtonEmpty" Classes="scriptFooter"
                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                  Command="{Binding ImportScriptCommand}" ToolTip.Tip="Импорт сценария из .aria-script.json" Content="Импорт"/>
        </StackPanel>
      </StackPanel>
      <StackPanel IsVisible="{Binding ShowEmptyScript}" Spacing="6" Margin="0,24,0,0" HorizontalAlignment="Center">
        <PathIcon Data="{StaticResource icon_script}" Width="24" Height="24" Foreground="{StaticResource BrushFaint}"
                  HorizontalAlignment="Center"/>
        <TextBlock Text="Сценарий пуст" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Первая строка станет отсчётом шоу" FontSize="12" Foreground="{StaticResource BrushDim}"
                   HorizontalAlignment="Center"/>
        <Button Classes="scriptFooter" Margin="0,4,0,0" HorizontalAlignment="Center"
                Command="{Binding AddLineCommand}" Content="+ строка"/>
      </StackPanel>
      <Button Classes="scriptFooter" Margin="0,6,0,0" HorizontalAlignment="Stretch"
              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
              Command="{Binding AddLineCommand}" Content="+ строка" IsVisible="{Binding HasScripts}"/>
      <Separator x:Name="ScriptFooterSeparator" Margin="0,10,0,6" IsVisible="{Binding HasScripts}"
                 Background="{StaticResource BrushLine}"/>
      <WrapPanel x:Name="ScriptFooterActions" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
        <Button x:Name="NewScriptButton" Classes="scriptFooter" IsVisible="{Binding HasScripts}"
                Command="{Binding CreateScriptCommand}" ToolTip.Tip="Новый сценарий">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource icon_plus}" Width="12" Height="12" VerticalAlignment="Center"/>
            <TextBlock Text="Новый" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="DeleteScriptButton" Classes="scriptFooter" IsVisible="{Binding HasScripts}"
                Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Удалить сценарий навсегда">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource icon_x}" Width="12" Height="12" VerticalAlignment="Center"/>
            <TextBlock Text="Удалить" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ImportScriptButton" Classes="scriptFooter" IsVisible="{Binding HasScripts}"
                Command="{Binding ImportScriptCommand}" Content="Импорт"
                ToolTip.Tip="Импорт сценария из .aria-script.json"/>
        <Button x:Name="ExportScriptButton" Classes="scriptFooter" IsVisible="{Binding HasScripts}"
                Command="{Binding ExportScriptCommand}" Content="Экспорт"
                ToolTip.Tip="Экспорт сценария в .aria-script.json"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
