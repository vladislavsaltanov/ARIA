<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aria.App.ViewModels"
        x:Class="Aria.App.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Настройки"
        Width="700" Height="760" MinWidth="560" MinHeight="500"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushFg}"
        CanResize="True">
  <Window.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*" Margin="18">
    <TextBlock Text="Настройки" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Grid Grid.Row="1" ColumnDefinitions="170,*">
      <ListBox x:Name="SectionNav" SelectionChanged="OnSectionSelected"
               Background="Transparent" BorderThickness="0" FontSize="13"/>
      <ScrollViewer Grid.Column="1" Margin="14,0,0,0">
        <StackPanel x:Name="SectionHost"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
