<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aria.App.ViewModels"
        xmlns:views="using:Aria.App.Views"
        x:Class="Aria.App.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Настройки"
        Width="620" Height="760"
        Background="#0F0F0F" Foreground="#ECECEC"
        CanResize="False">
  <Window.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="BorderBrush" Value="#2C2C2C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8A8A8A"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="#1F1F1F"/>
      <Setter Property="BorderBrush" Value="#2C2C2C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="#ECECEC"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A2A2A"/>
    </Style>
  </Window.Styles>
  <ScrollViewer>
    <StackPanel Margin="18">
      <TextBlock Text="Настройки" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>

      <Border Classes="section">
        <StackPanel>
          <TextBlock Text="Пульт" Classes="sectionTitle"/>
          <views:RemotePanel x:Name="PairingPanel" Background="Transparent"/>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Жесты" Classes="sectionTitle"/>
            <Button Grid.Column="1" Classes="action" Content="сбросить" Command="{Binding ResetGesturesCommand}"
                    ToolTip.Tip="Вернуть умолчания" MinHeight="26" Padding="10,0" FontSize="11"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Gestures}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsViewModel+GestureRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="13"/>
                    <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#E5484D"
                               IsVisible="{Binding HasError}"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="RecordButton" Content="{Binding RecordText}"
                          FontFamily="{StaticResource MonoFont}" FontSize="12" MinWidth="120"
                          Classes="action" Click="OnRecordClick" ToolTip.Tip="Записать жест"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="запись: кликните жест и нажмите клавиши; Esc — отмена; конфликты проверяются мгновенно"
                     FontSize="11" Foreground="#565656" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Часы" Classes="sectionTitle"/>
            <TextBlock Text="elapsed сбрасывается только вручную" FontSize="11" Foreground="#565656"/>
          </StackPanel>
          <Button VerticalAlignment="Center" Classes="action" Content="Сбросить show clock"
                  Command="{Binding ResetClockCommand}" x:Name="ResetClockButton"/>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel>
          <TextBlock Text="Формат строк" Classes="sectionTitle"/>
          <CheckBox x:Name="UseFileNameCheck" Content="имя файла вместо метаданных"
                    IsChecked="{Binding UseFileName}" FontSize="12"/>
          <TextBox x:Name="RowFormatBox" Text="{Binding RowFormat, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,8,0,4"
                   Background="#1F1F1F" BorderBrush="#2C2C2C"/>
          <TextBlock Text="токены: {position} {name} {filename} {duration}" FontSize="11" Foreground="#565656"/>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Classes="action" Content="Применить" Command="{Binding SaveRowSettingsCommand}"
                    x:Name="ApplyRowFormatButton"/>
            <TextBlock Text="{Binding RowSettingsStatus}" FontSize="11" Foreground="#565656" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel>
          <TextBlock Text="Движок" Classes="sectionTitle"/>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="фейд PANIC" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding PanicFadeMs, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="14,0"/>
            <TextBlock Grid.Column="2" Text="{Binding PanicFadeMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                       FontSize="11" Foreground="#8A8A8A" VerticalAlignment="Center" Width="60"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
