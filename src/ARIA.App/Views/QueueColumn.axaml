<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.QueueColumn"
             x:DataType="vm:QueueViewModel">
  <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}"
          BorderThickness="1" CornerRadius="8" Margin="14,10,14,10">
    <Grid RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="12,10,6,6">
        <TextBlock Text="Очередь" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="ghost" MinHeight="26" Padding="8,0" ToolTip.Tip="Очистить очередь"
                Command="{Binding ClearQueueCommand}" Margin="0,0,2,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource icon_x}" Width="11" Height="11" VerticalAlignment="Center"/>
            <TextBlock Text="Очистить" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" x:Name="QueueCloseButton" Classes="ghost" Width="26" Height="26"
                Click="OnCloseClick" ToolTip.Tip="Закрыть очередь">
          <PathIcon Data="{StaticResource icon_x}" Width="11" Height="11"/>
        </Button>
      </Grid>
      <ListBox Grid.Row="1" x:Name="QueueList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
               DoubleTapped="OnItemDoubleTapped"
               Background="Transparent" BorderThickness="0" Margin="6,0,6,10"
               ItemContainerTheme="{StaticResource PlainRowItem}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:QueueViewModel+QueueItemVm">
            <Border Classes="qRow" Height="36" CornerRadius="6" Padding="10,0" Background="Transparent">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Играть сейчас" Click="OnPlayNowClick"/>
                  <MenuItem Header="Убрать из очереди" Click="OnRemoveClick"/>
                </ContextMenu>
              </Border.ContextMenu>
              <Grid ColumnDefinitions="18,*">
                <PathIcon Data="{StaticResource icon_play}" Width="12" Height="12" VerticalAlignment="Center"
                          IsVisible="{Binding IsCurrent}"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
