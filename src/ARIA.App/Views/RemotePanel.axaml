<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.RemotePanel"
             x:DataType="vm:RemotePanelViewModel"
             Background="{StaticResource BrushBg}">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LetterSpacing" Value="1.5"/>
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LetterSpacing" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="110"/>
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="24" MaxWidth="620">
      <StackPanel Spacing="6" HorizontalAlignment="Center">
        <TextBlock x:Name="RemoteTitle" Text="ПУЛЬТ" Foreground="{StaticResource BrushFg}" FontSize="22"
                   FontFamily="{StaticResource MonoFont}" LetterSpacing="3" HorizontalAlignment="Center"/>
        <TextBlock Text="браузер в той же локальной сети — тот же шоу-пульт" Foreground="{StaticResource BrushDim}"
                   FontSize="12" HorizontalAlignment="Center"/>
      </StackPanel>
      <Border Classes="card" HorizontalAlignment="Stretch">
        <StackPanel Spacing="14">
          <TextBlock Text="ПОДКЛЮЧЕНИЕ" Classes="cardTitle"/>
          <Border Background="#FFFFFF" Padding="12" HorizontalAlignment="Center" CornerRadius="4" IsVisible="{Binding HasInfo}">
            <Image Source="{Binding QrImage}" Width="232" Height="232" />
          </Border>
          <TextBlock Text="LAN-адрес не найден" IsVisible="{Binding !HasInfo}" Foreground="{StaticResource BrushDim}"
                     FontSize="15" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center" />
          <SelectableTextBlock Text="{Binding UrlText}" Foreground="{StaticResource BrushFg}" FontSize="15"
                               FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock Text="отсканируйте QR или откройте адрес в браузере" Foreground="{StaticResource BrushDim}"
                     FontSize="11" TextAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Classes="card" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">
          <TextBlock Text="ДОСТУП" Classes="cardTitle"/>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="ИДЕНТИФИКАТОР" Classes="key"/>
            <SelectableTextBlock Grid.Column="1" Text="{Binding IdentifierText}" Foreground="{StaticResource BrushFg}"
                                 FontSize="16" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="ПАРОЛЬ" Classes="key"/>
            <SelectableTextBlock Grid.Column="1" Text="{Binding PasswordText}" Foreground="{StaticResource BrushFg}"
                                 FontSize="16" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
          </Grid>
          <Button Command="{Binding ResetPasswordCommand}" Classes="action" Content="новый пароль" HorizontalAlignment="Left"/>
          <TextBlock Text="пульт сохраняет пару в браузере; сброс пароля делает старый QR недействительным — пересканируйте"
                     Foreground="{StaticResource BrushDim}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding MdnsStatus}" Foreground="{StaticResource BrushDim}" FontSize="12"
                     FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
      </Border>
      <Border Classes="card" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">
          <TextBlock Text="МОНИТОРИНГ ДЛЯ МУЗЫКАНТОВ" Classes="cardTitle"/>
          <Border Background="#FFFFFF" Padding="12" HorizontalAlignment="Center" CornerRadius="4" IsVisible="{Binding HasListenInfo}">
            <Image x:Name="ListenQr" Source="{Binding ListenQrImage}" Width="200" Height="200" />
          </Border>
          <SelectableTextBlock Text="{Binding ListenUrlText}" Foreground="{StaticResource BrushFg}" FontSize="13"
                               FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" TextAlignment="Center"/>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="ПАРОЛЬ" Classes="key"/>
            <SelectableTextBlock Grid.Column="1" Text="{Binding ListenPasswordText}" Foreground="{StaticResource BrushFg}"
                                 FontSize="16" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
          </Grid>
          <Button Command="{Binding ResetListenPasswordCommand}" Classes="action" Content="новый пароль слушателей" HorizontalAlignment="Left"/>
          <TextBlock Text="этот QR открывает только прослушку и клик — пульт и PANIC музыкантам недоступны; сброс отключает всех слушателей"
                     Foreground="{StaticResource BrushDim}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
