<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.RemotePanel"
             x:DataType="vm:RemotePanelViewModel"
             Background="{StaticResource BrushBg}">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="24" MaxWidth="560">
    <TextBlock x:Name="RemoteTitle" Text="ПУЛЬТ" Foreground="{StaticResource BrushFg}" FontSize="22" FontFamily="{StaticResource MonoFont}" LetterSpacing="3" HorizontalAlignment="Center" />
    <Border Background="#FFFFFF" Padding="12" HorizontalAlignment="Center" IsVisible="{Binding HasInfo}">
      <Image Source="{Binding QrImage}" Width="232" Height="232" />
    </Border>
    <TextBlock Text="LAN-адрес не найден" IsVisible="{Binding !HasInfo}" Foreground="{StaticResource BrushDim}"
               FontSize="16" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center" />
    <SelectableTextBlock Text="{Binding UrlText}" Foreground="{StaticResource BrushFg}" FontSize="15" FontFamily="{StaticResource MonoFont}"
                         TextWrapping="Wrap" TextAlignment="Center" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
      <TextBlock Text="ИДЕНТИФИКАТОР" Foreground="{StaticResource BrushDim}" FontSize="12" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
      <SelectableTextBlock Text="{Binding IdentifierText}" Foreground="{StaticResource BrushFg}" FontSize="17" FontFamily="{StaticResource MonoFont}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
      <TextBlock Text="ПАРОЛЬ" Foreground="{StaticResource BrushDim}" FontSize="12" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
      <SelectableTextBlock Text="{Binding PasswordText}" Foreground="{StaticResource BrushFg}" FontSize="17" FontFamily="{StaticResource MonoFont}" />
    </StackPanel>
    <Button Command="{Binding ResetPasswordCommand}" Content="новый пароль"
            Background="{StaticResource BrushSurfaceAlt}" Foreground="{StaticResource BrushFg}" BorderBrush="{StaticResource BrushSurfaceHi}" Padding="18 8"
            FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center" />
    <TextBlock Text="пульт сохраняет пару в браузере; сброс пароля делает старый QR недействительным — пересканируйте"
               Foreground="{StaticResource BrushDim}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
    <TextBlock Text="{Binding MdnsStatus}" Foreground="{StaticResource BrushDim}" FontSize="13" FontFamily="{StaticResource MonoFont}"
               HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
