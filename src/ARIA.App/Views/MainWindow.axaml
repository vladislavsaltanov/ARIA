<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aria.App.ViewModels"
        xmlns:views="using:Aria.App.Views"
        x:Class="Aria.App.Views.MainWindow"
        x:DataType="vm:TransportViewModel"
        Title="ARIA"
        Width="900" Height="560"
        Background="#0F0F0F"
        CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#8A8A8A" FontSize="14" FontFamily="Consolas, Menlo" />
      <TextBlock Grid.Column="1" Text="LOCKED" IsVisible="{Binding Locked}" Foreground="#E8B44A" FontSize="14"
                 FontWeight="Bold" FontFamily="Consolas, Menlo" Margin="12,0,0,0" />
    </Grid>
    <TabControl Grid.Row="1" Background="#0F0F0F" BorderThickness="0" Margin="0,12,0,0">
      <TabItem Header="TRANSPORT" Foreground="#EDEDED">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="{Binding DisplayName}" Foreground="#EDEDED" FontSize="22" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Text="{Binding Remaining}" Foreground="#F2F2F2" FontSize="112" FontWeight="Bold"
                     FontFamily="Consolas, Menlo" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,*">
            <Button Grid.Column="1" Content="PLAY" Command="{Binding PlayCommand}" Width="96" Height="56" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="PAUSE" Command="{Binding PauseCommand}" Width="96" Height="56" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="STOP" Command="{Binding StopCommand}" Width="96" Height="56" Margin="0,0,8,0" />
            <Button Grid.Column="4" Content="NEXT" Command="{Binding NextCommand}" Width="96" Height="56" Margin="0,0,8,0" />
            <Button Grid.Column="5" Content="REPLAY" Command="{Binding ReplayCommand}" Width="96" Height="56" Margin="0,0,8,0" />
            <Button Grid.Column="6" Content="PANIC" Command="{Binding PanicCommand}" IsEnabled="{Binding !Panicked}" Width="112" Height="56"
                    Background="#1A0A0A" BorderBrush="#C43A3A" BorderThickness="2" Foreground="#E86A6A"
                    FontSize="18" FontWeight="Bold" />
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="ShowTab" Header="SHOW" Foreground="#EDEDED">
        <views:PlaylistsView />
      </TabItem>
      <TabItem x:Name="LibraryTab" Header="LIBRARY" Foreground="#EDEDED">
        <views:LibraryView />
      </TabItem>
      <TabItem x:Name="RemoteTab" Header="REMOTE" Foreground="#EDEDED">
        <views:RemotePanel />
      </TabItem>
    </TabControl>
    <views:TransportBar x:Name="TransportBar" Grid.Row="2" Height="76" Margin="-24,12,-24,-24" />
    <Border x:Name="HelpOverlay" Grid.RowSpan="3" IsVisible="False" Background="#D90F0F0F"
            PointerPressed="OnHelpOverlayClick">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#161616"
              BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="28,22" MinWidth="470">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Text="Горячие клавиши" FontSize="16" FontWeight="SemiBold" Foreground="#ECECEC"/>
            <TextBlock Grid.Column="1" Text="F1 или клик — закрыть" FontSize="11" Foreground="#8A8A8A" VerticalAlignment="Center"/>
          </Grid>
          <Grid x:Name="HotkeyTable" ColumnDefinitions="*,130" Margin="0,10,0,0">
            <TextBlock Text="Действие" FontSize="11" Foreground="#565656"/>
            <TextBlock Grid.Column="1" Text="Жест" FontSize="11" Foreground="#565656" TextAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
