<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aria.App.ViewModels"
        xmlns:views="using:Aria.App.Views"
        x:Class="Aria.App.Views.MainWindow"
        x:DataType="vm:TransportViewModel"
        Title="ARIA"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="#0F0F0F"
        CanResize="True">
  <Window.Styles>
    <Style Selector="Button.railAction">
      <Setter Property="Height" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>
    <Style Selector="Button.railAction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.railAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F1F1F"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="#8A8A8A"/>
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F1F1F"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="*,Auto,Auto" Margin="24">
    <SplitView Grid.Row="0" x:Name="ScriptDrawer" PanePlacement="Right" DisplayMode="Overlay"
               OpenPaneLength="340" IsPaneOpen="False">
      <SplitView.Pane>
        <Border Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1,0,0,0">
          <Grid ColumnDefinitions="8,*">
            <Thumb Grid.Column="0" x:Name="PaneResizer" Width="8" Background="Transparent"
                   VerticalAlignment="Stretch" Cursor="SizeWestEast" DragDelta="OnPaneResize"
                   ToolTip.Tip="Ширина панели"/>
            <views:ScriptPanel Grid.Column="1" x:Name="ScriptPanel" Margin="10,14,12,10"/>
          </Grid>
        </Border>
      </SplitView.Pane>
      <Grid ColumnDefinitions="260,*,300">
      <Border Grid.Column="0" BorderBrush="#2C2C2C" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="3*,2*,Auto,Auto">
          <views:LibrarySection Grid.Row="0" x:Name="LibrarySection" />
          <views:RailPlaylists Grid.Row="1" x:Name="RailPlaylists" />
          <Button Grid.Row="2" x:Name="QueueButton" Classes="railAction" Margin="8,4,8,0" Click="OnQueueJumpClick">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource icon_list}" Width="15" Height="15"/>
              <TextBlock Text="Очередь" FontSize="13"/>
            </StackPanel>
          </Button>
          <Button Grid.Row="3" x:Name="ImportButton" Classes="railAction" Margin="8,6,8,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource icon_plus}" Width="15" Height="15"/>
              <TextBlock Text="Import" FontSize="13"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <views:PlaylistCenter Grid.Column="1" x:Name="PlaylistCenter" />
      <views:QueueColumn Grid.Column="2" x:Name="QueueColumn" />
      </Grid>
    </SplitView>
    <TabControl Grid.Row="1" Background="#0F0F0F" BorderThickness="0" Margin="0,12,0,0">
      <TabItem x:Name="RemoteTab" Header="REMOTE" Foreground="#EDEDED">
        <views:RemotePanel />
      </TabItem>
    </TabControl>
    <views:TransportBar x:Name="TransportBar" Grid.Row="2" Height="76" Margin="-24,12,-24,-24" />
    <Border x:Name="FocusSink" Grid.RowSpan="3" Width="0" Height="0" Focusable="True" IsHitTestVisible="False"/>
    <Border x:Name="HelpOverlay" Grid.RowSpan="3" IsVisible="False" Background="#D90F0F0F"
            PointerPressed="OnHelpOverlayClick">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#161616"
              BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="10" Padding="28,22" MinWidth="470">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Text="Горячие клавиши" FontSize="16" FontWeight="SemiBold" Foreground="#ECECEC"/>
            <TextBlock Grid.Column="1" Text="F1 или клик — закрыть" FontSize="11" Foreground="#8A8A8A" VerticalAlignment="Center"/>
          </Grid>
          <Grid x:Name="HotkeyTable" ColumnDefinitions="*,130" Margin="0,10,0,0">
            <TextBlock Text="Действие" FontSize="11" Foreground="#565656"/>
            <TextBlock Grid.Column="1" Text="Жест" FontSize="11" Foreground="#565656" TextAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
