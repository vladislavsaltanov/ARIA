<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.RailPlaylists"
             x:DataType="vm:PlaylistsViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,10,8,6">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <PathIcon Data="{StaticResource icon_list}" Width="15" Height="15" Foreground="{StaticResource BrushDim}"/>
        <TextBlock Text="Плейлисты" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost" Width="26" Height="26" Command="{Binding CreatePlaylistCommand}" ToolTip.Tip="Новый плейлист">
        <PathIcon Data="{StaticResource icon_plus}" Width="13" Height="13"/>
      </Button>
    </Grid>
    <ListBox Grid.Row="1" x:Name="PlaylistNames" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
             Background="Transparent" BorderThickness="0" Margin="8,0,8,4">
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0"/>
        </ControlTheme>
      </ListBox.ItemContainerTheme>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PlaylistsViewModel+PlaylistVm">
          <Border Height="30" CornerRadius="6" Padding="12,0" Background="Transparent">
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Удалить плейлист" Click="OnDeleteClick"/>
              </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
