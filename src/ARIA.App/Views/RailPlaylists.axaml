<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.RailProjects"
             x:DataType="vm:ProjectsViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox#ProjectNames ListBoxItem">
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="ListBox#ProjectNames ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox#ProjectNames ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushHover}"/>
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.railChip">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="Button.railChip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.railChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" DragDrop.AllowDrop="True" DragDrop.Drop="OnRailDropped" DragDrop.DragOver="OnRailDragOver">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,8,8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <PathIcon Data="{StaticResource icon_list}" Width="15" Height="15" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <TextBlock Text="Проекты" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushFg}" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="railChip" Command="{Binding CreateProjectCommand}" ToolTip.Tip="Новый проект">
        <PathIcon Data="{StaticResource icon_plus}" Width="13" Height="13"/>
      </Button>
    </Grid>
    <ListBox Grid.Row="1" x:Name="ProjectNames" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
             Background="Transparent" BorderThickness="0" Margin="8,0,8,4"
             ItemContainerTheme="{StaticResource PlainRowItem}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ProjectsViewModel+ProjectVm">
          <Border Height="36" CornerRadius="6" Padding="12,0" Background="Transparent">
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Закрыть проект" Click="OnDeleteClick"/>
              </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
