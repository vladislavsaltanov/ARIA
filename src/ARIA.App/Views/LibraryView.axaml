<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Background="#0F0F0F">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <Button Content="IMPORT" Command="{Binding ImportCommand}" Width="128" Height="48" FontSize="16" FontWeight="Bold" />
      <Button Content="ADD TO ACTIVE" Command="{Binding AddToActiveCommand}" Width="188" Height="48" FontSize="16" FontWeight="Bold" />
      <Button Content="ENQUEUE" Command="{Binding EnqueueSelectedCommand}" Width="128" Height="48" FontSize="16" FontWeight="Bold" />
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectedItem="{Binding Selected}"
             Background="#161616" BorderBrush="#2A2A2A" Margin="0,12,0,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryViewModel+TrackVm">
          <Grid ColumnDefinitions="*,Auto" Margin="4" MinHeight="36">
            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#EDEDED" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="#8A8A8A" FontSize="15"
                       FontFamily="Consolas, Menlo" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#8A8A8A" FontSize="13" FontFamily="Consolas, Menlo" />
      <TextBlock Grid.Column="1" Text="BUSY…" IsVisible="{Binding IsBusy}" Foreground="#E8B44A" FontSize="13"
                 FontWeight="Bold" FontFamily="Consolas, Menlo" Margin="12,0,0,0" />
    </Grid>
  </Grid>
</UserControl>
