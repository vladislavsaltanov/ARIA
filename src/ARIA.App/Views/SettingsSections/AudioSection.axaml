<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             xmlns:vms="using:Aria.App.ViewModels.Settings"
             x:Class="Aria.App.Views.SettingsSections.AudioSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section" x:DataType="vms:AudioSectionVm" DataContext="{Binding Audio}">
    <StackPanel>
      <TextBlock Text="Звук" Classes="sectionTitle"/>
      <TextBlock Text="Устройства вывода" Classes="groupLabel"/>
      <Grid ColumnDefinitions="120,*" Margin="0,0,0,8" VerticalAlignment="Center">
        <TextBlock Text="основной" Classes="fieldLabel"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedValue="{Binding SelectedOutputId, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}"
                  MinHeight="30" HorizontalAlignment="Stretch"/>
      </Grid>
      <Grid ColumnDefinitions="120,*" Margin="0,0,0,4" VerticalAlignment="Center">
        <TextBlock Text="прослушка" Classes="fieldLabel"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedValue="{Binding SelectedPreviewOutputId, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}"
                  MinHeight="30" HorizontalAlignment="Stretch"/>
      </Grid>
      <TextBlock Text="{Binding OutputStatus}" Classes="hint" Margin="120,0,0,1"/>
      <TextBlock Text="{Binding PreviewOutputStatus}" Classes="hint" Margin="120,0,0,10"/>
      <TextBlock Text="Эквалайзер" Classes="groupLabel"/>
      <ItemsControl ItemsSource="{Binding EqBands}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vms:AudioSectionVm+EqBandVm">
            <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
              <TextBlock Text="{Binding Label}" Classes="fieldLabel"/>
              <Slider Grid.Column="1" Minimum="-15" Maximum="15" Value="{Binding GainDb, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="14,0"/>
              <TextBlock Grid.Column="2" Text="{Binding GainDb, StringFormat={}{0:0.0} дБ}" Classes="value" Width="64"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <CheckBox Content="лимитер" IsChecked="{Binding LimiterEnabled}" Margin="0,14,0,2"/>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="порог" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="-24" Maximum="0" Value="{Binding LimiterThresholdDb, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding LimiterThresholdDb, StringFormat={}{0:0.0} дБ}" Classes="value" Width="64"/>
      </Grid>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="восстановление" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="10" Maximum="1000" Value="{Binding LimiterReleaseMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding LimiterReleaseMs, StringFormat={}{0:0} мс}" Classes="value" Width="64"/>
      </Grid>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="баланс" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Pan, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding Pan, StringFormat={}{0:0.00}}" Classes="value" Width="64"/>
      </Grid>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="срез низов" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="400" Value="{Binding HpfHz, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding HpfHz, StringFormat={}{0:0} Гц}" Classes="value" Width="64"/>
      </Grid>
      <CheckBox Content="моно" IsChecked="{Binding Mono}" Margin="0,8,0,0"/>
      <TextBlock Text="Нормализация" Classes="groupLabel" Margin="0,16,0,2"/>
      <CheckBox Content="включена" IsChecked="{Binding NormalizeEnabled}" Margin="0,0,0,2"/>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="цель" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="-36" Maximum="-6" Value="{Binding NormalizeTargetLufs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding NormalizeTargetLufs, StringFormat={}{0:0.0} LUFS}" Classes="value" Width="64"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" VerticalAlignment="Center">
        <Button Content="Измерить весь проект" Classes="action" Command="{Binding MeasureProjectCommand}"/>
        <TextBlock Text="{Binding NormalizeProjectStatus}" Classes="hint" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Шкала LUFS" Classes="groupLabel"/>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="зелёный от" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding ZoneGreenDb, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding ZoneGreenDb, StringFormat={}{0:0.0}}" Classes="value" Width="64"/>
      </Grid>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="жёлтый от" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding ZoneYellowDb, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding ZoneYellowDb, StringFormat={}{0:0.0}}" Classes="value" Width="64"/>
      </Grid>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="красный от" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding ZoneRedDb, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding ZoneRedDb, StringFormat={}{0:0.0}}" Classes="value" Width="64"/>
      </Grid>
      <TextBlock Text="Прослушка" Classes="groupLabel"/>
      <Grid ColumnDefinitions="120,*,Auto" Margin="0,8,0,0">
        <TextBlock Text="громкость" Classes="fieldLabel"/>
        <Slider Grid.Column="1" Minimum="-80" Maximum="12" Value="{Binding PreviewGainDb, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding PreviewGainDb, StringFormat={}{0:0.0} дБ}" Classes="value" Width="64"/>
      </Grid>
      <CheckBox Content="заглушить прослушку" IsChecked="{Binding PreviewMuted}" Margin="0,8,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
