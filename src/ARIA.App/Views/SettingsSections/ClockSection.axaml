<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.SettingsSections.ClockSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Часы" Classes="sectionTitle"/>
        <TextBlock Text="elapsed сбрасывается только вручную" FontSize="11" Foreground="{StaticResource BrushFaint}"/>
      </StackPanel>
      <Button VerticalAlignment="Center" Classes="action" Content="Сбросить show clock"
              Command="{Binding ResetClockCommand}" x:Name="ResetClockButton"/>
    </StackPanel>
  </Border>
</UserControl>
