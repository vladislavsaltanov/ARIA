<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             xmlns:vms="using:Aria.App.ViewModels.Settings"
             x:Class="Aria.App.Views.SettingsSections.ClockSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section" x:DataType="vms:ClockSectionVm" DataContext="{Binding Clock}">
    <StackPanel>
      <TextBlock Text="Часы шоу" Classes="sectionTitle"/>
      <TextBlock Text="сбрасываются только вручную — пауза шоу их не трогает" Classes="hint" Margin="0,0,0,12"/>
      <Button VerticalAlignment="Center" Classes="action" Content="Сбросить часы шоу"
              Command="{Binding ResetClockCommand}" x:Name="ResetClockButton" HorizontalAlignment="Left"/>
    </StackPanel>
  </Border>
</UserControl>
