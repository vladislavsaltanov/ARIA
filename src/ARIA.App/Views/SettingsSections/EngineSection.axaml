<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.SettingsSections.EngineSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section">
    <StackPanel>
      <TextBlock Text="Движок" Classes="sectionTitle"/>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="фейд PANIC" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding PanicFadeMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding PanicFadeMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="60"/>
      </Grid>
      <CheckBox Content="сглаживание (как в AIMP)" IsChecked="{Binding SmoothingEnabled}"
                FontSize="12" Margin="0,12,0,4"/>
      <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding SmoothingEnabled}">
        <TextBlock Text="кроссфейд вручную" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding ManualCrossfadeMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding ManualCrossfadeMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="60"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding SmoothingEnabled}" Margin="0,6,0,0">
        <TextBlock Text="кроссфейд по очереди" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="3000" Value="{Binding AutoCrossfadeMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding AutoCrossfadeMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="60"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding SmoothingEnabled}" Margin="0,6,0,0">
        <TextBlock Text="скорость запуска" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding StartFadeMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding StartFadeMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="60"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding SmoothingEnabled}" Margin="0,6,0,0">
        <TextBlock Text="скорость затухания" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding StopFadeMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding StopFadeMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="60"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding SmoothingEnabled}" Margin="0,6,0,0">
        <TextBlock Text="кроссфейд перемотки" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding SeekFadeMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding SeekFadeMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="60"/>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
