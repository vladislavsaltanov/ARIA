<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             xmlns:vms="using:Aria.App.ViewModels.Settings"
             x:Class="Aria.App.Views.SettingsSections.LogSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section" x:DataType="vms:LogSectionVm" DataContext="{Binding Logging}">
    <StackPanel>
      <TextBlock Text="Журнал" Classes="sectionTitle"/>
      <CheckBox x:Name="LogEnabledCheck" Content="вести журнал" IsChecked="{Binding LogEnabled, Mode=TwoWay}"
                Margin="0,0,0,6"/>
      <Grid ColumnDefinitions="140,*" IsEnabled="{Binding LogEnabled}">
        <TextBlock Text="уровень" Classes="fieldLabel"/>
        <ComboBox Grid.Column="1" x:Name="LogLevelBox" SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}"
                  MinHeight="30" MinWidth="160" HorizontalAlignment="Left">
          <ComboBoxItem>Отладка</ComboBoxItem>
          <ComboBoxItem>Информация</ComboBoxItem>
          <ComboBoxItem>Предупреждения</ComboBoxItem>
          <ComboBoxItem>Ошибки</ComboBoxItem>
        </ComboBox>
      </Grid>
      <TextBlock x:Name="LogPathText" Text="{Binding LogPath}" FontFamily="{StaticResource MonoFont}"
                 FontSize="11" Foreground="{StaticResource BrushDim}" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <Button x:Name="ShowLogButton" Classes="action" Content="Показать файл" Click="OpenFolder_Click"
              Margin="0,12,0,0" HorizontalAlignment="Left"/>
      <TextBlock Text="Переменная ARIA_LOG_LEVEL перекрывает настройку." Classes="hint" Margin="0,10,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
