<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             xmlns:vms="using:Aria.App.ViewModels.Settings"
             x:Class="Aria.App.Views.SettingsSections.LogSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section" x:DataType="vms:LogSectionVm" DataContext="{Binding Logging}">
    <StackPanel>
      <TextBlock Text="Журнал" Classes="sectionTitle"/>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="уровень" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" x:Name="LogLevelBox" SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}"
                  VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="160">
          <ComboBoxItem>Отладка</ComboBoxItem>
          <ComboBoxItem>Информация</ComboBoxItem>
          <ComboBoxItem>Предупреждения</ComboBoxItem>
          <ComboBoxItem>Ошибки</ComboBoxItem>
        </ComboBox>
      </Grid>
      <TextBlock x:Name="LogPathText" Text="{Binding LogPath}" FontSize="11" Foreground="{StaticResource BrushDim}"
                 Margin="0,10,0,0" TextWrapping="Wrap"/>
      <Button x:Name="ShowLogButton" Classes="action" Content="Показать файл" Click="OpenFolder_Click"
              Margin="0,10,0,0" HorizontalAlignment="Left"/>
      <TextBlock Text="Переменная ARIA_LOG_LEVEL перекрывает настройку." FontSize="11"
                 Foreground="{StaticResource BrushDim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</UserControl>
