<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             xmlns:vms="using:Aria.App.ViewModels.Settings"
             x:Class="Aria.App.Views.SettingsSections.MonitorsSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section" x:DataType="vms:MonitorsSectionVm" DataContext="{Binding Monitors}">
    <StackPanel>
      <TextBlock Text="Мониторы" Classes="sectionTitle"/>
      <TextBlock Text="Активные веб-пульты: уровни подложки и метронома на клиента, отключение" FontSize="11" Foreground="{StaticResource BrushFaint}" Margin="0,0,0,10"/>
      <ItemsControl ItemsSource="{Binding Sessions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vms:MonitorSessionVm">
            <Border BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Content="Отключить" Command="{Binding KickCommand}" Classes="action" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                  <TextBlock Text="подложка" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" Minimum="-80" Maximum="12" Value="{Binding BackingGainDb, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="14,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding BackingGainDb, StringFormat={}{0:0.0} дБ}" FontFamily="{StaticResource MonoFont}"
                             FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="64"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                  <TextBlock Text="метроном" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" Minimum="-80" Maximum="12" Value="{Binding ClickGainDb, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="14,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding ClickGainDb, StringFormat={}{0:0.0} дБ}" FontFamily="{StaticResource MonoFont}"
                             FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="64"/>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
