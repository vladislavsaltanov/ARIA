<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             xmlns:vms="using:Aria.App.ViewModels.Settings"
             x:Class="Aria.App.Views.SettingsSections.PlaybackSection"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="section" x:DataType="vms:PlaybackSectionVm" DataContext="{Binding Playback}">
    <StackPanel>
      <TextBlock Text="Воспроизведение" Classes="sectionTitle"/>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="после конца трека" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" x:Name="EndActionBox" SelectedIndex="{Binding DefaultEndActionIndex, Mode=TwoWay}"
                  VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="160">
          <ComboBoxItem>Пауза</ComboBoxItem>
          <ComboBoxItem>Стоп</ComboBoxItem>
          <ComboBoxItem>Повтор</ComboBoxItem>
          <ComboBoxItem>Далее</ComboBoxItem>
        </ComboBox>
      </Grid>
      <CheckBox x:Name="MeterSmoothingCheck" Content="сглаживание индикаторов" IsChecked="{Binding MeterSmoothingEnabled}"
                FontSize="12" Margin="0,10,0,0"/>
      <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding MeterSmoothingEnabled}" Margin="0,6,0,0">
        <TextBlock Text="время спада" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
        <Slider x:Name="MeterSmoothingSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="{Binding MeterSmoothingReleaseMs, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="14,0"/>
        <TextBlock Grid.Column="2" Text="{Binding MeterSmoothingReleaseMs, StringFormat={}{0:0} мс}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Width="60"/>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
