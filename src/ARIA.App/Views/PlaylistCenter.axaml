<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aria.App.ViewModels"
             x:Class="Aria.App.Views.ProjectCenter"
             x:DataType="vm:ProjectsViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem.dropBefore /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BrushSignal}"/>
      <Setter Property="BorderThickness" Value="0,3,0,0"/>
    </Style>
    <Style Selector="ListBoxItem.dropAfter /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BrushSignal}"/>
      <Setter Property="BorderThickness" Value="0,0,0,3"/>
    </Style>
    <Style Selector="Border.plRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.plRow:pointerover">
      <Setter Property="Background" Value="{StaticResource BrushHover}"/>
    </Style>
    <Style Selector="Border.plRow.selected">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="Border.plRow.selected:pointerover">
      <Setter Property="Background" Value="#242424"/>
    </Style>
    <Style Selector="Border.plRow.note">
      <Setter Property="BorderBrush" Value="{StaticResource BrushNoteLine}"/>
      <Setter Property="BorderThickness" Value="0,1,0,1"/>
    </Style>
    <Style Selector="ListBox#EntryList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox#EntryList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox#EntryList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.plRow.linked">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushSignal}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>
    <Style Selector="Border.plRow Path.wave">
      <Setter Property="Fill" Value="{StaticResource BrushWave}"/>
    </Style>
    <Style Selector="Border.plRow.linked Path.wave">
      <Setter Property="Fill" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="Border.plRow.linked TextBlock.duration">
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
    <Style Selector="Button.chip:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.chipIcon">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="Button.chipIcon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.chipIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="TextBlock.col">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="LetterSpacing" Value="0.5"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" Margin="16,0,0,0">
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,10,0,8">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="{Binding SelectedProject.Name}" FontSize="18" FontWeight="SemiBold"
                     DoubleTapped="OnTitleDoubleTapped" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="TitleBox" Text="{Binding SelectedProject.Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                   IsVisible="False" MinWidth="200" KeyDown="OnTitleKeyDown" LostFocus="OnTitleCommit"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,0">
          <Button x:Name="ScenarioButton" Classes="chip" MinHeight="32" Padding="10,0"
                  Click="OnScenarioClick" ToolTip.Tip="Сценарий — Ctrl+T" VerticalAlignment="Center"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource icon_script}" Width="14" Height="14" VerticalAlignment="Center"/>
              <TextBlock Text="Сценарий" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="AddNoteButton" Classes="chip" MinHeight="32" Padding="10,0"
                  Click="OnAddNoteClick" ToolTip.Tip="Заметка — текстовая строка в плейлисте"
                  VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource icon_script}" Width="14" Height="14" VerticalAlignment="Center"/>
              <TextBlock Text="Заметка" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Column="2" Classes="chipIcon" Width="32" Height="32"
                x:Name="CloseProjectButton" Click="OnDeleteProjectClick" ToolTip.Tip="Закрыть проект" VerticalAlignment="Center" Margin="6,0,10,0">
          <PathIcon Data="{StaticResource icon_x}" Width="13" Height="13"/>
        </Button>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,10,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding EntryCountText}" Classes="col" FontSize="11" Foreground="{StaticResource BrushDim}"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ProjectIoStatus}" FontSize="12" Foreground="{StaticResource BrushDim}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding ProjectIoStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        <Grid Grid.Column="1" Width="230" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource icon_search}" Width="14" Height="14" Foreground="{StaticResource BrushFaint}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <TextBox PlaceholderText="Поиск по списку" Text="{Binding CenterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Padding="28,5,26,5" FontSize="12" Background="{StaticResource BrushSurfaceAlt}"
                   BorderBrush="{StaticResource BrushLine}" MinHeight="30" CornerRadius="6" VerticalContentAlignment="Center"/>
          <Button Classes="chipIcon" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,3,0" Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding CenterSearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  ToolTip.Tip="Очистить поиск">
            <PathIcon Data="{StaticResource icon_x}" Width="11" Height="11"/>
          </Button>
        </Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="28,*,72,58,110,32" Margin="10,0,10,6" IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Grid.Column="0" Text="№" Classes="col" Padding="10,0,0,0"/>
      <TextBlock Grid.Column="1" Text="ТРЕК" Classes="col" Margin="8,0,0,0"/>
      <TextBlock Grid.Column="2" Text="КОНЕЦ" Classes="col" HorizontalAlignment="Right"/>
      <TextBlock Grid.Column="3" Text="ВРЕМЯ" Classes="col" HorizontalAlignment="Right"/>
      <TextBlock Grid.Column="4" Text="ФОРМА" Classes="col" Margin="10,0,0,0"/>
      <Border Grid.ColumnSpan="6" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,-3"/>
    </Grid>
    <Panel Grid.Row="2" x:Name="PlaylistArea" ToolTip.Tip="Перетащите файлы для импорта · ПКМ — импорт и экспорт">
      <Panel.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Добавить заметку" Click="OnAddNoteClick"/>
          <MenuItem Header="Импорт">
            <MenuItem Header="Аудио…" Command="{Binding ImportAudioCommand}"/>
            <MenuItem Header="Папка…" Command="{Binding ImportAudioFolderCommand}"/>
            <MenuItem Header="Проект (.aria-project.json)…" Command="{Binding ImportProjectCommand}"/>
            <MenuItem Header="Проект из ZIP (.aria.zip)…" Command="{Binding ImportZipCommand}"/>
          </MenuItem>
          <MenuItem Header="Экспорт">
            <MenuItem Header="Проект (.aria-project.json)" Command="{Binding ExportProjectCommand}"/>
            <MenuItem Header="ZIP со звуком (.aria.zip)" Command="{Binding ExportZipCommand}"/>
          </MenuItem>
        </ContextMenu>
      </Panel.ContextMenu>
      <ListBox x:Name="EntryList" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry}"
               DoubleTapped="OnEntryDoubleTapped" KeyDown="OnEntryListKeyDown" DragDrop.AllowDrop="True" DragDrop.Drop="OnFilesDropped" DragDrop.DragOver="OnFilesDragOver"
               Background="Transparent" BorderThickness="0" Margin="0,0,0,10"
               ItemContainerTheme="{StaticResource PlaylistRowItem}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectsViewModel+EntryVm">
            <Border Classes="plRow" Classes.linked="{Binding IsLinked}" Classes.note="{Binding IsNote}"
                    Classes.selected="{Binding $parent[ListBoxItem].IsSelected}" CornerRadius="6" Padding="10,0,12,0">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Править" Click="OnEditNoteClick" IsVisible="{Binding IsNote}"/>
                  <MenuItem Header="В очередь" Click="OnEnqueueClick" IsVisible="{Binding !IsNote}"/>
                  <MenuItem Header="Действие в конце" SubmenuOpened="OnEndActionMenuOpened" IsVisible="{Binding !IsNote}">
                    <MenuItem Header="Наследовать" Tag="inherit" ToggleType="Radio" GroupName="EndAction" Click="OnEndActionClick"/>
                    <MenuItem Header="Пауза" Tag="pause" ToggleType="Radio" GroupName="EndAction" Click="OnEndActionClick"/>
                    <MenuItem Header="Стоп" Tag="stop" ToggleType="Radio" GroupName="EndAction" Click="OnEndActionClick"/>
                    <MenuItem Header="Повтор" Tag="replay" ToggleType="Radio" GroupName="EndAction" Click="OnEndActionClick"/>
                    <MenuItem Header="Далее" Tag="advance" ToggleType="Radio" GroupName="EndAction" Click="OnEndActionClick"/>
                  </MenuItem>
                  <MenuItem Header="Убрать из проекта" Click="OnRemoveClick"/>
                  <MenuItem Header="Звук…" Click="OnAudioClick" IsVisible="{Binding !IsNote}"/>
                </ContextMenu>
              </Border.ContextMenu>
              <StackPanel>
                <Grid ColumnDefinitions="28,*,72,58,110,32" Height="44" Tapped="OnRowTapped">
                  <Panel>
                    <TextBlock Text="{Binding Position}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"
                               IsVisible="{Binding !IsLinked}"/>
                    <PathIcon Data="{StaticResource icon_play}" Width="11" Height="11" VerticalAlignment="Center"
                              Foreground="{StaticResource BrushSignal}" IsVisible="{Binding IsLinked}"/>
                  </Panel>
                  <TextBlock Grid.Column="1" Text="{Binding RowText}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsNote}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                             Foreground="{StaticResource BrushFg}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsNote}"/>
                  <Border Grid.Column="2" Classes="badge" HorizontalAlignment="Right"
                          IsVisible="{Binding HasEndActionOverride}" ToolTip.Tip="{Binding EndActionTip}">
                    <TextBlock Text="{Binding EndActionBadge}"/>
                  </Border>
                  <TextBlock Grid.Column="3" Classes="duration" Text="{Binding DurationText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" HorizontalAlignment="Right" IsVisible="{Binding !IsNote}"/>
                  <TextBlock Grid.Column="3" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Foreground="{StaticResource BrushFaint}" VerticalAlignment="Center" HorizontalAlignment="Right" IsVisible="{Binding IsNote}"/>
                  <Path Grid.Column="4" Classes="wave" Data="{Binding Waveform}" Stretch="Fill" Width="100" Height="18"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding !IsNote}"/>
                  <PathIcon Grid.Column="4" Data="{StaticResource icon_script}" Width="14" Height="14"
                            Foreground="{StaticResource BrushFaint}" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="12,0,0,0" IsVisible="{Binding IsNote}"/>
                  <PathIcon Grid.Column="5" Data="{StaticResource icon_alert}" Width="16" Height="16"
                            Foreground="{StaticResource BrushFaulted}" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="8,0,2,0" IsVisible="{Binding IsFaulted}"
                            Tapped="OnFaultIconTapped" ToolTip.Tip="Трек не загрузился — показать причину"/>
                </Grid>
                <Border x:Name="NoteBody" IsVisible="{Binding NoteExpandedVisible}" Margin="8,0,4,6" Padding="10,2,10,8"
                        Background="{StaticResource BrushSurfaceAlt}" CornerRadius="4">
                  <TextBlock Text="{Binding Note}" FontSize="13" Foreground="{StaticResource BrushFg}" TextWrapping="Wrap"/>
                </Border>
                <TextBox x:Name="NoteEditor" IsVisible="{Binding IsEditing}"
                         Text="{Binding $parent[ListBox].DataContext.NoteDraft, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" Margin="8,0,4,6" Padding="8,6"
                         FontSize="13" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}"
                         KeyDown="OnNoteEditorKeyDown" LostFocus="OnNoteEditorLostFocus"
                         AttachedToVisualTree="OnNoteEditorAttached"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,-20,0,0"
                  IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNull}}">
        <PathIcon Data="{StaticResource icon_list}" Width="26" Height="26" Foreground="{StaticResource BrushFaint}"
                  HorizontalAlignment="Center"/>
        <TextBlock Text="Проектов нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Создайте проект кнопкой «+» в рейле «Проекты»" FontSize="12"
                   Foreground="{StaticResource BrushDim}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
