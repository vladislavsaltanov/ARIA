<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aria.Prototype.MainWindow"
        Title="ARIA — прототип главного окна"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        FontSize="13"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushFg}">
  <Window.Resources>
    <ControlTheme x:Key="ThinSliderTheme" TargetType="Slider">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid VerticalAlignment="Center" Height="28" Background="Transparent">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource BrushLine}"/>
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   Orientation="Horizontal">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Height="4" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" Background="{StaticResource BrushFg}"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Height="4" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" Background="Transparent"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb Width="12" Height="12" Background="{StaticResource BrushFg}" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.transport">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
    <Style Selector="Button.transport /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
    <Style Selector="Button.transport:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushLine}"/>
    </Style>
    <Style Selector="ToggleButton.transport">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
    <Style Selector="ToggleButton.transport /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
    <Style Selector="ToggleButton.transport:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
    </Style>
    <Style Selector="ToggleButton.transport PathIcon.iconPause">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ToggleButton.transport:checked PathIcon.iconPause">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="ToggleButton.transport:checked PathIcon.iconPlay">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="Button.railAction">
      <Setter Property="Height" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
    </Style>
    <Style Selector="Button.railAction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.railAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="Button.panic">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E5484D"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="#E5484D"/>
    </Style>
    <Style Selector="Button.panic /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#E5484D"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.panic:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#281314"/>
    </Style>
    <Style Selector="Button.panic:pressed">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E5484D"/>
      </Style>
    </Style>
    <Style Selector="Border.libRow:pointerover">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="Border.libRow.linked">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushFg}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.plRow.linked">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceHi}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushFg}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>
    <Style Selector="Border.libRow.selected">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="Border.plRow:pointerover">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="Border.plRow.selected">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushFg}"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Style>
    <Style Selector="Border.dropTarget">
      <Setter Property="BorderBrush" Value="{StaticResource BrushFg}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.scriptLine:pointerover">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
    </Style>
    <Style Selector="Border.scriptLine:pointerover Button.goHint">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.scriptLine.current">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushFg}"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Style>
    <Style Selector="Border.scriptLine.editing">
      <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushDim}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.mention:pointerover">
      <Setter Property="Background" Value="#343434"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushFg}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Styles>
  <Panel>
    <Grid RowDefinitions="*,76">
      <SplitView x:Name="Drawer" Grid.Row="0" PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="340" IsPaneOpen="False" Background="Transparent">
        <SplitView.Pane>
          <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1,0,0,0">
            <Grid ColumnDefinitions="8,*">
              <Thumb Grid.Column="0" x:Name="PaneResizer" Width="8" Background="Transparent" Cursor="SizeWestEast" DragDelta="OnPaneResize" VerticalAlignment="Stretch" ToolTip.Tip="Ширина панели"/>
              <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="10,14,12,10">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBox x:Name="ScriptNameBox" Text="Новый сценарий" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0"/>
                <Button Grid.Column="1" x:Name="PaneCloseButton" Classes="ghost" Width="28" Height="28" Click="OnPaneCloseClick" ToolTip.Tip="Закрыть — Ctrl+T">
                  <PathIcon Data="{StaticResource icon_x}" Width="13" Height="13"/>
                </Button>
              </Grid>
              <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Classes="ghost" Height="26" Padding="10,0" FontSize="11" Content="7 строк" Tag="seven" Click="OnScriptDemoClick" Margin="0,0,6,6"/>
                <Button Classes="ghost" Height="26" Padding="10,0" FontSize="11" Content="50 строк" Tag="fifty" Click="OnScriptDemoClick" Margin="0,0,6,6"/>
                <Button Classes="ghost" Height="26" Padding="10,0" FontSize="11" Content="новый" Tag="empty" Click="OnScriptDemoClick" Margin="0,0,6,6"/>
                <Button Classes="ghost" Height="26" Padding="10,0" FontSize="11" Content="сохранить" Click="OnScriptSaveClick" ToolTip.Tip="Сохранить сценарий в файл" Margin="0,0,6,6"/>
                <Button Classes="ghost" Height="26" Padding="10,0" FontSize="11" Content="открыть" Click="OnScriptOpenClick" ToolTip.Tip="Открыть сценарий из файла" Margin="0,0,6,6"/>
                <Button Classes="ghost" Height="26" Padding="10,0" FontSize="11" Content="закрыть" Click="OnScriptCloseClick" ToolTip.Tip="Закрыть сценарий" Margin="0,0,6,6"/>
              </WrapPanel>
              <ScrollViewer Grid.Row="2">
                <StackPanel x:Name="ScriptLinesHost" Spacing="8">
                </StackPanel>
              </ScrollViewer>
                <TextBlock x:Name="StatusText" Grid.Row="3" Text="" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushFaint}" Margin="12,0,12,8" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Grid>
            </Border>
        </SplitView.Pane>
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="20,12,20,8">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="01:23:45" FontFamily="{StaticResource MonoFont}" FontSize="42" Foreground="{StaticResource BrushFg}"/>
              <TextBlock Text="21:47:03 · 02:11" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{StaticResource BrushDim}" Margin="2,0,0,0"/>
            </StackPanel>
            <Panel x:Name="WaveSeek" Grid.Column="1" Height="56" VerticalAlignment="Center" Background="Transparent" PointerPressed="OnWaveSeekPressed" ToolTip.Tip="Перемотка — клик по волне">
              <Path Data="{StaticResource wave_main}" Stretch="Fill" Height="56" Fill="{StaticResource BrushWave}"/>
              <Rectangle x:Name="WaveCursor" Width="2" Height="56" Fill="{StaticResource BrushFg}" HorizontalAlignment="Left"/>
            </Panel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="260,*,300">
            <Border Grid.Column="0" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,1,0">
              <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="14,10,14,8">
                  <PathIcon Data="{StaticResource icon_music}" Width="15" Height="15" Foreground="{StaticResource BrushDim}"/>
                  <TextBlock Text="Библиотека" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                  <Grid Grid.Row="0" Margin="12,0,12,8">
                    <PathIcon Data="{StaticResource icon_search}" Width="14" Height="14" Foreground="{StaticResource BrushFaint}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <TextBox PlaceholderText="Поиск по имени" Padding="28,6,8,8" VerticalContentAlignment="Center" FontSize="12" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}"/>
                  </Grid>
                  <StackPanel x:Name="LibraryStack" Grid.Row="1" Margin="0,0,0,4">
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t1}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Осенний дождь" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="3:42" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t2}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Night Drive" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="4:15" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t3}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Гул маяка" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="2:58" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                          <PathIcon Grid.Column="3" Data="{StaticResource icon_alert}" Width="13" Height="13" Foreground="{StaticResource BrushFaulted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,2,0"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t4}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Deep Current" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="5:07" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t5}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Полночь" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="3:21" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t6}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Slow Tide" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="4:48" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t7}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Стекло" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="3:05" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                          <PathIcon Grid.Column="3" Data="{StaticResource icon_alert}" Width="13" Height="13" Foreground="{StaticResource BrushFaulted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,2,0"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t8}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Amber Loop" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="6:12" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t9}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Тихий час" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="2:34" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <Border Classes="libRow" Height="30" CornerRadius="6" Margin="6,0" Padding="10,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                        <Grid ColumnDefinitions="56,*,34,28">
                          <Path Data="{StaticResource wave_t10}" Stretch="Fill" Width="53" Height="14" Fill="{StaticResource BrushWaveDim}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="Copper Sky" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          <TextBlock Grid.Column="2" Text="4:56" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="14,10,14,6">
                  <PathIcon Data="{StaticResource icon_list}" Width="15" Height="15" Foreground="{StaticResource BrushDim}"/>
                  <TextBlock Text="Плейлисты" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="8,0,8,4" Spacing="2">
                  <Border Height="30" CornerRadius="6" Background="{StaticResource BrushSurfaceAlt}" Padding="10,0" BorderBrush="{StaticResource BrushFg}" BorderThickness="2,0,0,0">
                    <TextBlock Text="Вечерний сет" FontSize="12" VerticalAlignment="Center"/>
                  </Border>
                  <Border Height="30" CornerRadius="6" Padding="12,0">
                    <TextBlock Text="Дневной фон" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                  </Border>
                  <Border Height="30" CornerRadius="6" Padding="12,0">
                    <TextBlock Text="Резерв" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
                <Button Grid.Row="4" Classes="railAction" Margin="8,4,8,0">
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource icon_list}" Width="15" Height="15"/>
                    <TextBlock Text="Очередь" FontSize="13" Margin="0,3,0,0"/>
                  </StackPanel>
                </Button>
                <Button Grid.Row="5" Classes="railAction" Margin="8,6,8,10" ToolTip.Tip="Импорт — выбрать файлы или папку">
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource icon_plus}" Width="15" Height="15"/>
                    <TextBlock Text="Import" FontSize="13" Margin="0,3,0,0"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="16,0,0,0">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,10,0,8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="Вечерний сет" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="5 треков · 19:07" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <Grid Grid.Column="2" Width="180" Margin="0,0,10,0">
                  <PathIcon Data="{StaticResource icon_search}" Width="14" Height="14" Foreground="{StaticResource BrushFaint}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"/>
                  <TextBox PlaceholderText="Поиск-подстрока" Padding="28,6,8,8" VerticalContentAlignment="Center" FontSize="12" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}"/>
                </Grid>
                <Button Grid.Column="3" x:Name="ScenarioToggle" Classes="ghost" Height="32" Padding="10,0" Click="OnScenarioToggleClick" ToolTip.Tip="Сценарий — Ctrl+T" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource icon_script}" Width="14" Height="14"/>
                    <TextBlock Text="Сценарий" FontSize="12" Margin="0,3,0,0"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" Classes="ghost" Width="32" Height="32" Click="OnHelpToggleClick" ToolTip.Tip="Горячие клавиши — F1" VerticalAlignment="Center" Margin="6,0,0,0">
                  <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
              </Grid>
              <StackPanel x:Name="PlaylistStack" Grid.Row="1" Margin="0,0,0,10" Spacing="2">
                <Border Classes="plRow selected" Height="44" CornerRadius="6" Padding="7,0,12,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                  <Grid ColumnDefinitions="28,*,58,130,30">
                    <TextBlock Text="01" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Осенний дождь" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="3:42" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Path Grid.Column="3" Data="{StaticResource wave_t1}" Stretch="Fill" Width="118" Height="18" Fill="{StaticResource BrushWave}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>
                <Border Classes="plRow" Height="44" CornerRadius="6" Padding="10,0,12,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                  <Grid ColumnDefinitions="28,*,58,130,30">
                    <TextBlock Text="02" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Night Drive" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="4:15" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Path Grid.Column="3" Data="{StaticResource wave_t2}" Stretch="Fill" Width="118" Height="18" Fill="{StaticResource BrushWave}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>
                <Border Classes="plRow" Height="44" CornerRadius="6" Padding="10,0,12,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                  <Grid ColumnDefinitions="28,*,58,130,30">
                    <TextBlock Text="03" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Гул маяка" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="2:58" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Path Grid.Column="3" Data="{StaticResource wave_t3}" Stretch="Fill" Width="118" Height="18" Fill="{StaticResource BrushWave}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <PathIcon Grid.Column="4" Data="{StaticResource icon_alert}" Width="13" Height="13" Foreground="{StaticResource BrushFaulted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,4,0"/>
                  </Grid>
                </Border>
                <Border Classes="plRow" Height="44" CornerRadius="6" Padding="10,0,12,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                  <Grid ColumnDefinitions="28,*,58,130,30">
                    <TextBlock Text="04" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Deep Current" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="5:07" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Path Grid.Column="3" Data="{StaticResource wave_t4}" Stretch="Fill" Width="118" Height="18" Fill="{StaticResource BrushWave}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>
                <Border Classes="plRow" Height="44" CornerRadius="6" Padding="10,0,12,0" Background="Transparent" PointerPressed="OnRowTap" PointerMoved="OnRowMove" PointerReleased="OnRowRelease">
                  <Grid ColumnDefinitions="28,*,58,130,30">
                    <TextBlock Text="05" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Стекло" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="3:05" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Path Grid.Column="3" Data="{StaticResource wave_t7}" Stretch="Fill" Width="118" Height="18" Fill="{StaticResource BrushWave}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <PathIcon Grid.Column="4" Data="{StaticResource icon_alert}" Width="13" Height="13" Foreground="{StaticResource BrushFaulted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,4,0"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
            <Border x:Name="QueuePanel" Grid.Column="2" Margin="14,10,14,10" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,10,6">
                  <TextBlock Text="Очередь" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Classes="ghost" Height="26" Padding="8,0" ToolTip.Tip="Очистить очередь" Click="OnClearQueueClick">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource icon_x}" Width="11" Height="11"/>
                      <TextBlock Text="Очистить" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Button>
                </Grid>
                <StackPanel x:Name="QueueStack" Grid.Row="1" Margin="6,0,6,4" Spacing="2">
                  <Border Height="36" CornerRadius="6" Background="{StaticResource BrushSurfaceAlt}" Padding="10,0">
                    <Grid ColumnDefinitions="18,*">
                      <PathIcon Data="{StaticResource icon_play}" Width="12" Height="12" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="Осенний дождь" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                  </Border>
                  <Border Height="36" CornerRadius="6" Padding="10,0">
                    <Grid ColumnDefinitions="18,*,36">
                      <TextBlock Grid.Column="1" Text="Полночь" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="3:21" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushFaint}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border Height="36" CornerRadius="6" Padding="10,0">
                    <Grid ColumnDefinitions="18,*,36">
                      <TextBlock Grid.Column="1" Text="Slow Tide" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="4:48" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushFaint}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border Height="36" CornerRadius="6" Padding="10,0">
                    <Grid ColumnDefinitions="18,*,36">
                      <TextBlock Grid.Column="1" Text="Amber Loop" FontSize="12" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="6:12" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushFaint}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </SplitView>
      <Border Grid.Row="1" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="3,*">
          <Grid Grid.Row="0" ColumnDefinitions="35*,65*">
            <Rectangle Grid.Column="0" Fill="{StaticResource BrushFg}" Opacity="0.85"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="14,0,10,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0" MinWidth="170">
              <TextBlock Text="Осенний дождь" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Далее: Полночь" FontSize="12" Foreground="{StaticResource BrushDim}" Margin="0,3,0,0"/>
            </StackPanel>
            <ToggleButton x:Name="PlayPause" Grid.Column="1" Classes="transport" Width="44" Height="44" IsChecked="True" Margin="0,0,7,0" VerticalAlignment="Center">
              <Panel>
                <PathIcon Classes="iconPlay" Data="{StaticResource icon_play}" Width="20" Height="20"/>
                <PathIcon Classes="iconPause" Data="{StaticResource icon_pause}" Width="20" Height="20"/>
              </Panel>
            </ToggleButton>
            <Button Grid.Column="2" Classes="transport" Width="44" Height="44" ToolTip.Tip="Стоп" Margin="0,0,7,0" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource icon_stop}" Width="18" Height="18"/>
            </Button>
            <Button Grid.Column="3" Classes="transport" Width="44" Height="44" ToolTip.Tip="Следующий — Ctrl+N" VerticalAlignment="Center" Margin="0,0,6,0">
              <PathIcon Data="{StaticResource icon_next}" Width="20" Height="20"/>
            </Button>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBlock Text="LUFS" FontSize="10" Foreground="{StaticResource BrushFaint}" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="−14.2" FontFamily="{StaticResource MonoFont}" FontSize="14" Width="44" TextAlignment="Right"/>
                <Border Width="44" Height="4" CornerRadius="2" Background="{StaticResource BrushLine}" Margin="0,4,0,0">
                  <Border Width="32" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushFg}"/>
                </Border>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="MuteButton" Classes="ghost" Width="30" Height="30" Click="OnMuteClick" ToolTip.Tip="Мьют — только мышь">
  <Panel PointerPressed="OnRootPointerPressed">
                  <PathIcon x:Name="SoundIcon" Data="{StaticResource icon_volume}" Width="17" Height="17"/>
                  <PathIcon x:Name="MutedIcon" Data="{StaticResource icon_volume_off}" Width="17" Height="17" IsVisible="False"/>
                </Panel>
              </Button>
              <Slider Theme="{StaticResource ThinSliderTheme}" Width="120" Minimum="0" Maximum="100" Value="70" ToolTip.Tip="Громкость — −6.0 дБ" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="7" VerticalAlignment="Center" Margin="18,0">
              <TextBlock Text="01:23:45" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
              <TextBlock Text="02:11" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushDim}"/>
            </StackPanel>
            <Border Grid.Column="8" Width="30" Height="30" VerticalAlignment="Center" ToolTip.Tip="Заблокировать — Ctrl+L">
              <PathIcon Data="{StaticResource icon_lock}" Width="16" Height="16" Foreground="{StaticResource BrushFaint}"/>
            </Border>
            <Button Grid.Column="9" Classes="ghost" Width="44" Height="44" ToolTip.Tip="Настройки — Ctrl+,-" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource icon_settings}" Width="18" Height="18"/>
            </Button>
            <Button Grid.Column="10" Classes="panic" ToolTip.Tip="PANIC — Ctrl+Shift+P" VerticalAlignment="Center" Margin="6,0,0,0">
              <TextBlock Text="PANIC" LetterSpacing="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="HelpOverlay" IsVisible="False" Background="#D90F0F0F" Focusable="True" PointerPressed="OnHelpOverlayClick">      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="28,22" MinWidth="470">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Text="Горячие клавиши" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="F1 или клик — закрыть" FontSize="11" Foreground="{StaticResource BrushDim}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,130" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">
            <TextBlock Text="Действие" FontSize="11" Foreground="{StaticResource BrushFaint}"/>
            <TextBlock Grid.Column="1" Text="Жест" FontSize="11" Foreground="{StaticResource BrushFaint}" TextAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="Воспроизведение" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Space" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Пауза" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Esc" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Text="PANIC" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl+Shift+P" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Text="Следующий трек" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Ctrl+N" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Text="Повторить трек" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Ctrl+R" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6" Text="Заблокировать управление" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Ctrl+L" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="7" Text="Панель сценария" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="Ctrl+T" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="8" Text="Сбросить show clock" FontSize="13" Margin="0,9,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Text="Ctrl+Shift+C" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushDim}" TextAlignment="Right" Margin="0,9,0,0" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
    <Border x:Name="FocusSink" Width="0" Height="0" Focusable="True" IsHitTestVisible="False"/>
    <Popup x:Name="ScriptPopup" IsLightDismissEnabled="True" Placement="Bottom">
      <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="200">
        <StackPanel x:Name="ScriptPopupList" Spacing="2"/>
      </Border>
    </Popup>
  </Panel>
</Window>
